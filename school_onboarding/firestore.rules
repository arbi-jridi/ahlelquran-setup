rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function callerEmail() {
      return request.auth.token.email.lower();
    }

    function isValidRole(role) {
      return role in ['ADMIN', 'TEACHER', 'STUDENT'];
    }

    function isLegacySchoolAdmin(schoolName) {
      return isSignedIn() && (
        (
          exists(/databases/$(database)/documents/$(schoolName)/admin)
          && (
            (
              'username' in get(/databases/$(database)/documents/$(schoolName)/admin).data
              && get(/databases/$(database)/documents/$(schoolName)/admin).data.username is string
              && get(/databases/$(database)/documents/$(schoolName)/admin).data.username.lower() == callerEmail()
            ) || (
              'email' in get(/databases/$(database)/documents/$(schoolName)/admin).data
              && get(/databases/$(database)/documents/$(schoolName)/admin).data.email is string
              && get(/databases/$(database)/documents/$(schoolName)/admin).data.email.lower() == callerEmail()
            )
          )
        ) || (
          exists(/databases/$(database)/documents/$(schoolName)/settings)
          && 'admin' in get(/databases/$(database)/documents/$(schoolName)/settings).data
          && get(/databases/$(database)/documents/$(schoolName)/settings).data.admin is map
          && 'username' in get(/databases/$(database)/documents/$(schoolName)/settings).data.admin
          && get(/databases/$(database)/documents/$(schoolName)/settings).data.admin.username is string
          && get(/databases/$(database)/documents/$(schoolName)/settings).data.admin.username.lower() == callerEmail()
        )
      );
    }

    function matchesSchoolPayload(data, schoolName) {
      return !('schoolName' in data) || data.schoolName == schoolName;
    }

    function isPermittedRolePair(rolesList, allowedClassIds) {
      return rolesList is list
        && rolesList.size() == 2
        && isValidRole(rolesList[0])
        && isValidRole(rolesList[1])
        // Strictly prohibit Student-to-Student conversations
        && !(rolesList[0] == 'STUDENT' && rolesList[1] == 'STUDENT')
        // Teacher-to-Student requires at least one shared assigned class
        && (
          !rolesList.hasAll(['TEACHER', 'STUDENT'])
          || (allowedClassIds is list && allowedClassIds.size() > 0)
        );
    }

    // Multi-school & school-year isolated instant messaging rules
    match /{schoolName}/{schoolYearDocId}/messaging/{serviceDocId} {
      allow read, write: if isSignedIn();

      match /profiles/{userKey} {
        allow read: if isSignedIn();
        allow create, update: if (
            isSignedIn()
            && request.resource.data.schoolName == schoolName
            && request.resource.data.email == callerEmail()
            && isValidRole(request.resource.data.role)
          ) || (
            isLegacySchoolAdmin(schoolName)
            && matchesSchoolPayload(request.resource.data, schoolName)
          );
        allow delete: if isSignedIn()
          && resource.data.email == callerEmail();
      }

      match /blocks/{blockId} {
        allow get: if isLegacySchoolAdmin(schoolName)
          || (
            isSignedIn()
            && (
              resource == null
              || resource.data.blockerEmail == callerEmail()
              || resource.data.blockedEmail == callerEmail()
            )
          );
        allow list: if isLegacySchoolAdmin(schoolName)
          || (
            isSignedIn()
            && (
              resource.data.blockerEmail == callerEmail()
              || resource.data.blockedEmail == callerEmail()
            )
          );
        allow create, update: if (
            isSignedIn()
            && request.resource.data.schoolName == schoolName
            && request.resource.data.blockerEmail == callerEmail()
            && request.resource.data.blockerId != request.resource.data.blockedId
          ) || (
            isLegacySchoolAdmin(schoolName)
            && matchesSchoolPayload(request.resource.data, schoolName)
          );
        allow delete: if isSignedIn()
          && resource.data.blockerEmail == callerEmail();
      }

      match /conversations/{conversationId} {
        allow get: if isLegacySchoolAdmin(schoolName)
          || (
            isSignedIn()
            && (
              resource == null
              || callerEmail() in resource.data.participantEmails
            )
          );
        allow list: if isLegacySchoolAdmin(schoolName)
          || (
            isSignedIn()
            && callerEmail() in resource.data.participantEmails
          );

        allow create: if (
            isSignedIn()
            && request.resource.data.schoolName == schoolName
            && request.resource.data.participantIds is list
            && request.resource.data.participantIds.size() == 2
            && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
            && request.resource.data.participantEmails is list
            && request.resource.data.participantEmails.size() == 2
            && callerEmail() in request.resource.data.participantEmails
            && isPermittedRolePair(
                 request.resource.data.participantRolesList,
                 request.resource.data.allowedClassIds
               )
          ) || (
            isLegacySchoolAdmin(schoolName)
            && matchesSchoolPayload(request.resource.data, schoolName)
          );

        allow update: if isSignedIn()
          && callerEmail() in resource.data.participantEmails
          && request.resource.data.schoolName == schoolName
          && request.resource.data.participantIds == resource.data.participantIds
          && request.resource.data.participantEmails == resource.data.participantEmails
          && isPermittedRolePair(
               request.resource.data.participantRolesList,
               request.resource.data.allowedClassIds
             );

        allow delete: if isSignedIn()
          && callerEmail() in resource.data.participantEmails;

        match /messages/{messageId} {
          allow read: if isLegacySchoolAdmin(schoolName)
            || (
              isSignedIn()
              && callerEmail() in get(/databases/$(database)/documents/$(schoolName)/$(schoolYearDocId)/messaging/$(serviceDocId)/conversations/$(conversationId)).data.participantEmails
            );

          allow create: if (
              isSignedIn()
              && request.resource.data.schoolName == schoolName
              && request.resource.data.conversationId == conversationId
              && request.resource.data.senderEmail == callerEmail()
              && request.resource.data.senderId != request.resource.data.receiverId
              && isValidRole(request.resource.data.senderRole)
              && isValidRole(request.resource.data.receiverRole)
              && !(request.resource.data.senderRole == 'STUDENT' && request.resource.data.receiverRole == 'STUDENT')
              && callerEmail() in get(/databases/$(database)/documents/$(schoolName)/$(schoolYearDocId)/messaging/$(serviceDocId)/conversations/$(conversationId)).data.participantEmails
              && request.resource.data.senderId in get(/databases/$(database)/documents/$(schoolName)/$(schoolYearDocId)/messaging/$(serviceDocId)/conversations/$(conversationId)).data.participantIds
              && request.resource.data.receiverId in get(/databases/$(database)/documents/$(schoolName)/$(schoolYearDocId)/messaging/$(serviceDocId)/conversations/$(conversationId)).data.participantIds
              && get(/databases/$(database)/documents/$(schoolName)/$(schoolYearDocId)/messaging/$(serviceDocId)/conversations/$(conversationId)).data.blockedBy.size() == 0
              && !exists(/databases/$(database)/documents/$(schoolName)/$(schoolYearDocId)/messaging/$(serviceDocId)/blocks/$(request.resource.data.receiverId + '__' + request.resource.data.senderId))
              && !exists(/databases/$(database)/documents/$(schoolName)/$(schoolYearDocId)/messaging/$(serviceDocId)/blocks/$(request.resource.data.senderId + '__' + request.resource.data.receiverId))
            ) || (
              isLegacySchoolAdmin(schoolName)
              && matchesSchoolPayload(request.resource.data, schoolName)
            );

          allow update: if isSignedIn()
            && callerEmail() in get(/databases/$(database)/documents/$(schoolName)/$(schoolYearDocId)/messaging/$(serviceDocId)/conversations/$(conversationId)).data.participantEmails
            && request.resource.data.senderId == resource.data.senderId
            && request.resource.data.receiverId == resource.data.receiverId
            && request.resource.data.schoolName == resource.data.schoolName;

          allow delete: if isSignedIn()
            && resource.data.senderEmail == callerEmail();
        }
      }
    }

    function hasLibraryMembership(schoolName, schoolYearDocId, serviceDocId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/$(schoolName)/$(schoolYearDocId)/library/$(serviceDocId)/memberships/$(callerEmail()));
    }

    function libraryMemberData(schoolName, schoolYearDocId, serviceDocId) {
      return get(/databases/$(database)/documents/$(schoolName)/$(schoolYearDocId)/library/$(serviceDocId)/memberships/$(callerEmail())).data;
    }

    function isLibraryAdmin(schoolName, schoolYearDocId, serviceDocId) {
      return hasLibraryMembership(schoolName, schoolYearDocId, serviceDocId)
        && libraryMemberData(schoolName, schoolYearDocId, serviceDocId).role == 'ADMIN';
    }

    function isLibraryTeacher(schoolName, schoolYearDocId, serviceDocId) {
      return hasLibraryMembership(schoolName, schoolYearDocId, serviceDocId)
        && libraryMemberData(schoolName, schoolYearDocId, serviceDocId).role == 'TEACHER';
    }

    function isValidLibrarySection(sec) {
      return sec in ['VIDEO', 'READABLE', 'AUDIO', 'EXTERNAL_AUDIO'];
    }

    function isValidLibraryPayload(data, schoolName) {
      return data.schoolName == schoolName
        && isValidLibrarySection(data.sectionType)
        && data.visibility in ['PUBLIC', 'CLASS']
        && data.title is string
        && data.title.size() > 0
        && data.contentUrl is string
        && data.contentUrl.size() > 0
        && (data.visibility == 'PUBLIC' || (data.targetClassId is string && data.targetClassId.size() > 0))
        && (data.fileSizeBytes is int && data.fileSizeBytes >= 0 && (data.sectionType != 'VIDEO' || data.fileSizeBytes <= 52428800));
    }

    function canManageLibraryItem(schoolName, schoolYearDocId, serviceDocId, existingData) {
      return isLibraryAdmin(schoolName, schoolYearDocId, serviceDocId)
        || (isLibraryTeacher(schoolName, schoolYearDocId, serviceDocId) && existingData.createdByEmail == callerEmail());
    }

    function canCreateLibraryItemForScope(schoolName, schoolYearDocId, serviceDocId, newData) {
      return isValidLibraryPayload(newData, schoolName)
        && newData.createdByEmail == callerEmail()
        && (
          isLibraryAdmin(schoolName, schoolYearDocId, serviceDocId)
          || (
            isLibraryTeacher(schoolName, schoolYearDocId, serviceDocId)
            && (
              newData.visibility == 'PUBLIC'
              || (newData.targetClassId in libraryMemberData(schoolName, schoolYearDocId, serviceDocId).classIds)
            )
          )
        );
    }

    function isViewCountIncrementOnly(oldData, newData) {
      return newData.diff(oldData).affectedKeys().hasOnly(['viewsCount'])
        && newData.viewsCount is int
        && newData.viewsCount == oldData.viewsCount + 1;
    }

    // Multi-school & school-year isolated Educational Library rules
    match /{schoolName}/{schoolYearDocId}/library/{serviceDocId} {
      allow read, write: if isSignedIn();

      match /memberships/{emailKey} {
        allow get: if isLegacySchoolAdmin(schoolName) || (isSignedIn() && emailKey == callerEmail());
        allow list: if isLibraryAdmin(schoolName, schoolYearDocId, serviceDocId) || isLegacySchoolAdmin(schoolName);
        allow create, update: if (
            isSignedIn()
            && emailKey == callerEmail()
            && request.resource.data.schoolName == schoolName
            && request.resource.data.email == callerEmail()
            && isValidRole(request.resource.data.role)
          ) || (
            isLegacySchoolAdmin(schoolName)
            && matchesSchoolPayload(request.resource.data, schoolName)
          );
        allow delete: if isSignedIn() && emailKey == callerEmail();
      }

      match /user_states/{userKey} {
        allow get: if isLegacySchoolAdmin(schoolName)
          || (isSignedIn() && (resource == null || resource.data.email == callerEmail()));
        allow list: if isLegacySchoolAdmin(schoolName)
          || (isSignedIn() && resource.data.email == callerEmail());
        allow create, update: if (
            isSignedIn()
            && request.resource.data.schoolName == schoolName
            && request.resource.data.email == callerEmail()
          ) || (
            isLegacySchoolAdmin(schoolName)
            && matchesSchoolPayload(request.resource.data, schoolName)
          );
        allow delete: if isSignedIn()
          && resource.data.email == callerEmail();
      }

      match /public_sections/{sectionType}/items/{itemId} {
        allow get, list: if hasLibraryMembership(schoolName, schoolYearDocId, serviceDocId)
          || isLegacySchoolAdmin(schoolName);
        allow create: if (
            canCreateLibraryItemForScope(schoolName, schoolYearDocId, serviceDocId, request.resource.data)
            && request.resource.data.visibility == 'PUBLIC'
            && request.resource.data.isPublished == true
          ) || (
            isLegacySchoolAdmin(schoolName)
            && matchesSchoolPayload(request.resource.data, schoolName)
          );
        allow update: if (
            canManageLibraryItem(schoolName, schoolYearDocId, serviceDocId, resource.data)
            && isValidLibraryPayload(request.resource.data, schoolName)
            && request.resource.data.visibility == 'PUBLIC'
            && request.resource.data.isPublished == true
          ) || (
            hasLibraryMembership(schoolName, schoolYearDocId, serviceDocId)
            && isViewCountIncrementOnly(resource.data, request.resource.data)
          );
        allow delete: if canManageLibraryItem(schoolName, schoolYearDocId, serviceDocId, resource.data);
      }

      match /classes/{classId}/sections/{sectionType}/items/{itemId} {
        allow get, list: if isLegacySchoolAdmin(schoolName)
          || (
            hasLibraryMembership(schoolName, schoolYearDocId, serviceDocId)
            && (
              isLibraryAdmin(schoolName, schoolYearDocId, serviceDocId)
              || classId in libraryMemberData(schoolName, schoolYearDocId, serviceDocId).classIds
            )
          );
        allow create: if (
            canCreateLibraryItemForScope(schoolName, schoolYearDocId, serviceDocId, request.resource.data)
            && request.resource.data.visibility == 'CLASS'
            && request.resource.data.targetClassId == classId
            && request.resource.data.isPublished == true
          ) || (
            isLegacySchoolAdmin(schoolName)
            && matchesSchoolPayload(request.resource.data, schoolName)
          );
        allow update: if (
            canManageLibraryItem(schoolName, schoolYearDocId, serviceDocId, resource.data)
            && isValidLibraryPayload(request.resource.data, schoolName)
            && request.resource.data.visibility == 'CLASS'
            && request.resource.data.targetClassId == classId
            && request.resource.data.isPublished == true
          ) || (
            hasLibraryMembership(schoolName, schoolYearDocId, serviceDocId)
            && (isLibraryAdmin(schoolName, schoolYearDocId, serviceDocId) || classId in libraryMemberData(schoolName, schoolYearDocId, serviceDocId).classIds)
            && isViewCountIncrementOnly(resource.data, request.resource.data)
          );
        allow delete: if canManageLibraryItem(schoolName, schoolYearDocId, serviceDocId, resource.data);
      }

      match /all_published/{sectionType}/items/{itemId} {
        allow get, list: if isLibraryAdmin(schoolName, schoolYearDocId, serviceDocId)
          || isLegacySchoolAdmin(schoolName);
        allow create: if (
            canCreateLibraryItemForScope(schoolName, schoolYearDocId, serviceDocId, request.resource.data)
            && request.resource.data.isPublished == true
          ) || (
            isLegacySchoolAdmin(schoolName)
            && matchesSchoolPayload(request.resource.data, schoolName)
          );
        allow update: if (
            canManageLibraryItem(schoolName, schoolYearDocId, serviceDocId, resource.data)
            && isValidLibraryPayload(request.resource.data, schoolName)
            && request.resource.data.isPublished == true
          ) || (
            hasLibraryMembership(schoolName, schoolYearDocId, serviceDocId)
            && isViewCountIncrementOnly(resource.data, request.resource.data)
          );
        allow delete: if canManageLibraryItem(schoolName, schoolYearDocId, serviceDocId, resource.data);
      }

      match /drafts/{itemId} {
        allow get: if isLibraryAdmin(schoolName, schoolYearDocId, serviceDocId)
          || isLegacySchoolAdmin(schoolName)
          || (isLibraryTeacher(schoolName, schoolYearDocId, serviceDocId) && (resource == null || resource.data.createdByEmail == callerEmail()));
        allow list: if isLibraryAdmin(schoolName, schoolYearDocId, serviceDocId)
          || isLegacySchoolAdmin(schoolName)
          || (isLibraryTeacher(schoolName, schoolYearDocId, serviceDocId) && resource.data.createdByEmail == callerEmail());
        allow create: if canCreateLibraryItemForScope(schoolName, schoolYearDocId, serviceDocId, request.resource.data)
          || (isLegacySchoolAdmin(schoolName) && matchesSchoolPayload(request.resource.data, schoolName));
        allow update: if canManageLibraryItem(schoolName, schoolYearDocId, serviceDocId, resource.data)
          && isValidLibraryPayload(request.resource.data, schoolName);
        allow delete: if canManageLibraryItem(schoolName, schoolYearDocId, serviceDocId, resource.data);
      }

      match /announcements/{announcementId} {
        allow get, list: if isLegacySchoolAdmin(schoolName)
          || (
            hasLibraryMembership(schoolName, schoolYearDocId, serviceDocId)
            && (
              isLibraryAdmin(schoolName, schoolYearDocId, serviceDocId)
              || isLibraryTeacher(schoolName, schoolYearDocId, serviceDocId)
              || resource.data.visibility == 'PUBLIC'
              || resource.data.targetClassId in libraryMemberData(schoolName, schoolYearDocId, serviceDocId).classIds
            )
          );
        allow create: if isLibraryAdmin(schoolName, schoolYearDocId, serviceDocId)
          || isLibraryTeacher(schoolName, schoolYearDocId, serviceDocId)
          || (isLegacySchoolAdmin(schoolName) && matchesSchoolPayload(request.resource.data, schoolName));
        allow update, delete: if isLibraryAdmin(schoolName, schoolYearDocId, serviceDocId)
          || (isLibraryTeacher(schoolName, schoolYearDocId, serviceDocId) && resource.data.createdByEmail == callerEmail());
      }

      match /media_comments/{itemId}/comments/{commentId} {
        allow read, get, list: if isSignedIn();
        allow create: if (
            isSignedIn()
            && request.resource.data.schoolName == schoolName
            && request.resource.data.itemId == itemId
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
          ) || (
            isLegacySchoolAdmin(schoolName)
            && matchesSchoolPayload(request.resource.data, schoolName)
          );
        allow update, delete: if isSignedIn()
          && (
            isLibraryAdmin(schoolName, schoolYearDocId, serviceDocId)
            || resource.data.userKey == request.auth.uid
            || (request.auth.token.email != null && resource.data.userKey == request.auth.token.email.lower())
          );
      }
    }

    function hasAlertsMembership(schoolName, schoolYearDocId, serviceDocId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/$(schoolName)/$(schoolYearDocId)/alerts/$(serviceDocId)/memberships/$(callerEmail()));
    }

    function alertsMemberData(schoolName, schoolYearDocId, serviceDocId) {
      return get(/databases/$(database)/documents/$(schoolName)/$(schoolYearDocId)/alerts/$(serviceDocId)/memberships/$(callerEmail())).data;
    }

    function isAlertsAdmin(schoolName, schoolYearDocId, serviceDocId) {
      return hasAlertsMembership(schoolName, schoolYearDocId, serviceDocId)
        && alertsMemberData(schoolName, schoolYearDocId, serviceDocId).role == 'ADMIN';
    }

    function isAlertsTeacher(schoolName, schoolYearDocId, serviceDocId) {
      return hasAlertsMembership(schoolName, schoolYearDocId, serviceDocId)
        && alertsMemberData(schoolName, schoolYearDocId, serviceDocId).role == 'TEACHER';
    }

    function isValidAlertPayload(data, schoolName) {
      return data.schoolName == schoolName
        && data.title is string
        && data.title.size() > 0
        && data.content is string
        && data.content.size() > 0
        && data.categoryKey is string
        && data.categoryKey.size() > 0
        && data.targetScope in ['ALL_CLASSES', 'CLASS', 'PERSONAL']
        && data.attachmentType in ['NONE', 'PDF', 'IMAGE']
        && data.senderEmail == callerEmail()
        && isValidRole(data.senderRole)
        && (
          data.targetScope == 'ALL_CLASSES'
          || (data.targetScope == 'CLASS' && data.targetClassId is string && data.targetClassId.size() > 0)
          || (data.targetScope == 'PERSONAL' && data.recipientUserKey is string && data.recipientUserKey.size() > 0)
        );
    }

    function canManageAlertDoc(schoolName, schoolYearDocId, serviceDocId, existingData) {
      return (isAlertsAdmin(schoolName, schoolYearDocId, serviceDocId) || isAlertsTeacher(schoolName, schoolYearDocId, serviceDocId))
        && existingData.senderEmail == callerEmail();
    }

    // Multi-school & school-year isolated Alerts & Notifications service rules
    match /{schoolName}/{schoolYearDocId}/alerts/{serviceDocId} {
      allow read, write: if isSignedIn();

      match /memberships/{emailKey} {
        allow get: if isLegacySchoolAdmin(schoolName) || (isSignedIn() && emailKey == callerEmail());
        allow list: if isAlertsAdmin(schoolName, schoolYearDocId, serviceDocId) || isLegacySchoolAdmin(schoolName);
        allow create, update: if (
            isSignedIn()
            && emailKey == callerEmail()
            && request.resource.data.schoolName == schoolName
            && request.resource.data.email == callerEmail()
            && isValidRole(request.resource.data.role)
          ) || (
            isLegacySchoolAdmin(schoolName)
            && matchesSchoolPayload(request.resource.data, schoolName)
          );
        allow delete: if isSignedIn() && emailKey == callerEmail();
      }

      match /school_financial_policy/{policyId} {
        allow get, list: if hasAlertsMembership(schoolName, schoolYearDocId, serviceDocId)
          || isLegacySchoolAdmin(schoolName);
        allow create, update: if (
            isAlertsAdmin(schoolName, schoolYearDocId, serviceDocId)
            && request.resource.data.schoolName == schoolName
          ) || (
            isLegacySchoolAdmin(schoolName)
            && matchesSchoolPayload(request.resource.data, schoolName)
          );
        allow delete: if isAlertsAdmin(schoolName, schoolYearDocId, serviceDocId);
      }

      match /categories/{categoryId} {
        allow get, list: if hasAlertsMembership(schoolName, schoolYearDocId, serviceDocId)
          || isLegacySchoolAdmin(schoolName);
        allow create, update: if (
            (isAlertsAdmin(schoolName, schoolYearDocId, serviceDocId) || isAlertsTeacher(schoolName, schoolYearDocId, serviceDocId))
            && request.resource.data.schoolName == schoolName
            && request.resource.data.nameAr is string
            && request.resource.data.nameAr.size() > 0
          ) || (
            isLegacySchoolAdmin(schoolName)
            && matchesSchoolPayload(request.resource.data, schoolName)
          );
        allow delete: if isAlertsAdmin(schoolName, schoolYearDocId, serviceDocId)
          || (isAlertsTeacher(schoolName, schoolYearDocId, serviceDocId) && resource.data.createdByEmail == callerEmail());
      }

      match /user_states/{userKey} {
        allow get: if isLegacySchoolAdmin(schoolName)
          || (isSignedIn() && (resource == null || resource.data.email == callerEmail()));
        allow list: if isLegacySchoolAdmin(schoolName)
          || (isSignedIn() && resource.data.email == callerEmail());
        allow create, update: if (
            isSignedIn()
            && request.resource.data.schoolName == schoolName
            && request.resource.data.email == callerEmail()
          ) || (
            isLegacySchoolAdmin(schoolName)
            && matchesSchoolPayload(request.resource.data, schoolName)
          );
        allow delete: if isSignedIn()
          && resource.data.email == callerEmail();
      }

      match /devices/{userKey} {
        allow get: if isAlertsAdmin(schoolName, schoolYearDocId, serviceDocId)
          || isLegacySchoolAdmin(schoolName)
          || (isSignedIn() && (resource == null || resource.data.email == callerEmail()));
        allow list: if isAlertsAdmin(schoolName, schoolYearDocId, serviceDocId)
          || isAlertsTeacher(schoolName, schoolYearDocId, serviceDocId)
          || isLegacySchoolAdmin(schoolName);
        allow create, update: if (
            isSignedIn()
            && request.resource.data.schoolName == schoolName
            && request.resource.data.email == callerEmail()
          ) || (
            isLegacySchoolAdmin(schoolName)
            && matchesSchoolPayload(request.resource.data, schoolName)
          );
        allow delete: if isSignedIn()
          && resource.data.email == callerEmail();
      }

      // School-wide alerts: ONLY Administration (ADMIN) can send to all students
      match /public_items/{alertId} {
        allow get, list: if hasAlertsMembership(schoolName, schoolYearDocId, serviceDocId)
          || isLegacySchoolAdmin(schoolName);
        allow create: if (
            isAlertsAdmin(schoolName, schoolYearDocId, serviceDocId)
            && isValidAlertPayload(request.resource.data, schoolName)
            && request.resource.data.targetScope == 'ALL_CLASSES'
          ) || (
            isLegacySchoolAdmin(schoolName)
            && matchesSchoolPayload(request.resource.data, schoolName)
          );
        allow update: if isAlertsAdmin(schoolName, schoolYearDocId, serviceDocId)
          && isValidAlertPayload(request.resource.data, schoolName)
          && request.resource.data.targetScope == 'ALL_CLASSES';
        allow delete: if isAlertsAdmin(schoolName, schoolYearDocId, serviceDocId);
      }

      // Class-scoped alerts: Administration OR Teacher assigned to that specific class
      match /classes/{classId}/items/{alertId} {
        allow get, list: if isLegacySchoolAdmin(schoolName)
          || (
            hasAlertsMembership(schoolName, schoolYearDocId, serviceDocId)
            && (
              isAlertsAdmin(schoolName, schoolYearDocId, serviceDocId)
              || classId in alertsMemberData(schoolName, schoolYearDocId, serviceDocId).classIds
            )
          );
        allow create: if (
            isValidAlertPayload(request.resource.data, schoolName)
            && request.resource.data.targetScope == 'CLASS'
            && request.resource.data.targetClassId == classId
            && (
              isAlertsAdmin(schoolName, schoolYearDocId, serviceDocId)
              || (
                isAlertsTeacher(schoolName, schoolYearDocId, serviceDocId)
                && classId in alertsMemberData(schoolName, schoolYearDocId, serviceDocId).classIds
              )
            )
          ) || (
            isLegacySchoolAdmin(schoolName)
            && matchesSchoolPayload(request.resource.data, schoolName)
          );
        allow update: if canManageAlertDoc(schoolName, schoolYearDocId, serviceDocId, resource.data)
          && isValidAlertPayload(request.resource.data, schoolName)
          && request.resource.data.targetScope == 'CLASS'
          && request.resource.data.targetClassId == classId;
        allow delete: if canManageAlertDoc(schoolName, schoolYearDocId, serviceDocId, resource.data);
      }

      // Personal individual alerts (Absence/Tardiness per student, Fee payment, Salary payment, Auto overdue)
      match /personal/{recipientUserKey}/items/{alertId} {
        allow get: if isAlertsAdmin(schoolName, schoolYearDocId, serviceDocId)
          || isLegacySchoolAdmin(schoolName)
          || (hasAlertsMembership(schoolName, schoolYearDocId, serviceDocId) && alertsMemberData(schoolName, schoolYearDocId, serviceDocId).userKey == recipientUserKey)
          || (isAlertsTeacher(schoolName, schoolYearDocId, serviceDocId) && resource != null && resource.data.senderEmail == callerEmail());
        allow list: if isAlertsAdmin(schoolName, schoolYearDocId, serviceDocId)
          || isLegacySchoolAdmin(schoolName)
          || (hasAlertsMembership(schoolName, schoolYearDocId, serviceDocId) && alertsMemberData(schoolName, schoolYearDocId, serviceDocId).userKey == recipientUserKey)
          || (isAlertsTeacher(schoolName, schoolYearDocId, serviceDocId) && resource.data.senderEmail == callerEmail());
        allow create: if (
            isValidAlertPayload(request.resource.data, schoolName)
            && request.resource.data.targetScope == 'PERSONAL'
            && request.resource.data.recipientUserKey == recipientUserKey
            && (
              isAlertsAdmin(schoolName, schoolYearDocId, serviceDocId)
              || (
                isAlertsTeacher(schoolName, schoolYearDocId, serviceDocId)
                && request.resource.data.targetClassId in alertsMemberData(schoolName, schoolYearDocId, serviceDocId).classIds
                && request.resource.data.categoryKey in ['ABSENCE', 'TARDINESS']
              )
              || (
                hasAlertsMembership(schoolName, schoolYearDocId, serviceDocId)
                && alertsMemberData(schoolName, schoolYearDocId, serviceDocId).userKey == recipientUserKey
                && request.resource.data.isAutoOverdue == true
              )
            )
          ) || (
            isLegacySchoolAdmin(schoolName)
            && matchesSchoolPayload(request.resource.data, schoolName)
          );
        allow update: if canManageAlertDoc(schoolName, schoolYearDocId, serviceDocId, resource.data)
          && isValidAlertPayload(request.resource.data, schoolName)
          && request.resource.data.targetScope == 'PERSONAL'
          && request.resource.data.recipientUserKey == recipientUserKey;
        allow delete: if canManageAlertDoc(schoolName, schoolYearDocId, serviceDocId, resource.data)
          || ((isAlertsAdmin(schoolName, schoolYearDocId, serviceDocId) || isLegacySchoolAdmin(schoolName))
            && resource.data.get('isAutoOverdue', false) == true);
      }

      // Unified index for Administration & sender management
      match /all_items/{alertId} {
        allow get: if isAlertsAdmin(schoolName, schoolYearDocId, serviceDocId)
          || isLegacySchoolAdmin(schoolName)
          || (isAlertsTeacher(schoolName, schoolYearDocId, serviceDocId) && resource != null && resource.data.senderEmail == callerEmail())
          || (hasAlertsMembership(schoolName, schoolYearDocId, serviceDocId) && (resource == null || resource.data.recipientUserKey == alertsMemberData(schoolName, schoolYearDocId, serviceDocId).userKey));
        allow list: if isAlertsAdmin(schoolName, schoolYearDocId, serviceDocId)
          || isLegacySchoolAdmin(schoolName)
          || (isAlertsTeacher(schoolName, schoolYearDocId, serviceDocId) && resource.data.senderEmail == callerEmail());
        allow create: if (
            isValidAlertPayload(request.resource.data, schoolName)
            && (
              isAlertsAdmin(schoolName, schoolYearDocId, serviceDocId)
              || (
                isAlertsTeacher(schoolName, schoolYearDocId, serviceDocId)
                && request.resource.data.targetScope in ['CLASS', 'PERSONAL']
                && request.resource.data.targetClassId in alertsMemberData(schoolName, schoolYearDocId, serviceDocId).classIds
              )
              || (
                hasAlertsMembership(schoolName, schoolYearDocId, serviceDocId)
                && request.resource.data.targetScope == 'PERSONAL'
                && request.resource.data.recipientUserKey == alertsMemberData(schoolName, schoolYearDocId, serviceDocId).userKey
                && request.resource.data.isAutoOverdue == true
              )
            )
          ) || (
            isLegacySchoolAdmin(schoolName)
            && matchesSchoolPayload(request.resource.data, schoolName)
          );
        allow update: if canManageAlertDoc(schoolName, schoolYearDocId, serviceDocId, resource.data)
          && isValidAlertPayload(request.resource.data, schoolName);
        allow delete: if canManageAlertDoc(schoolName, schoolYearDocId, serviceDocId, resource.data)
          || ((isAlertsAdmin(schoolName, schoolYearDocId, serviceDocId) || isLegacySchoolAdmin(schoolName))
            && resource.data.get('isAutoOverdue', false) == true);
      }
    }

    function hasAnnouncementsMembership(schoolName, schoolYearDocId, serviceDocId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/$(schoolName)/$(schoolYearDocId)/announcements/$(serviceDocId)/memberships/$(callerEmail()));
    }

    function announcementsMemberData(schoolName, schoolYearDocId, serviceDocId) {
      return get(/databases/$(database)/documents/$(schoolName)/$(schoolYearDocId)/announcements/$(serviceDocId)/memberships/$(callerEmail())).data;
    }

    function isAnnouncementsAdmin(schoolName, schoolYearDocId, serviceDocId) {
      return hasAnnouncementsMembership(schoolName, schoolYearDocId, serviceDocId)
        && announcementsMemberData(schoolName, schoolYearDocId, serviceDocId).role == 'ADMIN';
    }

    function isValidAnnouncementPayload(data, schoolName) {
      return data.schoolName == schoolName
        && data.title is string
        && data.title.size() > 0
        && data.details is string
        && data.details.size() > 0
        && data.announcementType in ['NORMAL', 'IMPORTANT', 'SPECIAL', 'OCCASION', 'EVENT']
        && data.targetScope in ['ALL_CLASSES', 'SPECIFIC_CLASSES']
        && data.isArchived is bool
        && (
          data.targetScope == 'ALL_CLASSES'
          || (data.targetClassIds is list && data.targetClassIds.size() > 0)
        );
    }

    // Multi-school & school-year isolated Announcements service rules
    match /{schoolName}/{schoolYearDocId}/announcements/{serviceDocId} {
      allow read, write: if isSignedIn();

      match /memberships/{emailKey} {
        allow get: if isLegacySchoolAdmin(schoolName) || (isSignedIn() && emailKey == callerEmail());
        allow list: if isAnnouncementsAdmin(schoolName, schoolYearDocId, serviceDocId) || isLegacySchoolAdmin(schoolName);
        allow create, update: if (
            isSignedIn()
            && emailKey == callerEmail()
            && request.resource.data.schoolName == schoolName
            && request.resource.data.email == callerEmail()
            && isValidRole(request.resource.data.role)
          ) || (
            isLegacySchoolAdmin(schoolName)
            && matchesSchoolPayload(request.resource.data, schoolName)
          );
        allow delete: if isSignedIn() && emailKey == callerEmail();
      }

      match /user_states/{userKey} {
        allow get: if isLegacySchoolAdmin(schoolName)
          || (isSignedIn() && (resource == null || resource.data.email == callerEmail()));
        allow list: if isLegacySchoolAdmin(schoolName)
          || (isSignedIn() && resource.data.email == callerEmail());
        allow create, update: if (
            isSignedIn()
            && request.resource.data.schoolName == schoolName
            && request.resource.data.email == callerEmail()
          ) || (
            isLegacySchoolAdmin(schoolName)
            && matchesSchoolPayload(request.resource.data, schoolName)
          );
        allow delete: if isSignedIn()
          && resource.data.email == callerEmail();
      }

      match /items/{announcementId} {
        allow get, list: if isLegacySchoolAdmin(schoolName)
          || (
            hasAnnouncementsMembership(schoolName, schoolYearDocId, serviceDocId)
            && (
              isAnnouncementsAdmin(schoolName, schoolYearDocId, serviceDocId)
              || resource.data.targetScope == 'ALL_CLASSES'
              || (
                resource.data.targetClassIds is list
                && announcementsMemberData(schoolName, schoolYearDocId, serviceDocId).classIds is list
                && resource.data.targetClassIds.hasAny(announcementsMemberData(schoolName, schoolYearDocId, serviceDocId).classIds)
              )
            )
          );
        allow create: if (
            isAnnouncementsAdmin(schoolName, schoolYearDocId, serviceDocId)
            && isValidAnnouncementPayload(request.resource.data, schoolName)
          ) || (
            isLegacySchoolAdmin(schoolName)
            && matchesSchoolPayload(request.resource.data, schoolName)
          );
        allow update: if isAnnouncementsAdmin(schoolName, schoolYearDocId, serviceDocId)
          && isValidAnnouncementPayload(request.resource.data, schoolName);
        allow delete: if isAnnouncementsAdmin(schoolName, schoolYearDocId, serviceDocId);
      }
    }

    // Legacy root paths for the 5 year-scoped services:
    // Future writes (create/update) outside schoolYearDocId are STRICTLY FORBIDDEN.
    // Only the school Admin can read/delete remaining legacy records to move them into schoolYearDocId.
    match /{schoolName}/financial_settings {
      allow read, delete: if isLegacySchoolAdmin(schoolName);
      allow create, update: if false;
      match /{subPath=**} {
        allow read, delete: if isLegacySchoolAdmin(schoolName);
        allow create, update: if false;
      }
    }

    match /{schoolName}/messaging {
      allow read, delete: if isLegacySchoolAdmin(schoolName);
      allow create, update: if false;
      match /{subPath=**} {
        allow read, delete: if isLegacySchoolAdmin(schoolName);
        allow create, update: if false;
      }
    }

    match /{schoolName}/library {
      allow read, delete: if isLegacySchoolAdmin(schoolName);
      allow create, update: if false;
      match /{subPath=**} {
        allow read, delete: if isLegacySchoolAdmin(schoolName);
        allow create, update: if false;
      }
    }

    match /{schoolName}/alerts {
      allow read, delete: if isLegacySchoolAdmin(schoolName);
      allow create, update: if false;
      match /{subPath=**} {
        allow read, delete: if isLegacySchoolAdmin(schoolName);
        allow create, update: if false;
      }
    }

    match /{schoolName}/announcements {
      allow read, delete: if isLegacySchoolAdmin(schoolName);
      allow create, update: if false;
      match /{subPath=**} {
        allow read, delete: if isLegacySchoolAdmin(schoolName);
        allow create, update: if false;
      }
    }

    // Preserve existing school collections and pre-auth status checks without bypassing year-scoped service rules
    match /{schoolName}/{docId} {
      allow list: if isSignedIn();
      allow get, write: if docId != 'messaging'
        && docId != 'library'
        && docId != 'alerts'
        && docId != 'announcements'
        && docId != 'financial_settings';
    }

    match /{schoolName}/{docId}/{subCol}/{subDoc} {
      allow read, write: if docId != 'messaging'
        && docId != 'library'
        && docId != 'alerts'
        && docId != 'announcements'
        && docId != 'financial_settings'
        && subCol != 'messaging'
        && subCol != 'library'
        && subCol != 'alerts'
        && subCol != 'announcements';
    }

    match /{schoolName}/{docId}/{subCol}/{subDoc}/{restPath=**} {
      allow read, write: if docId != 'messaging'
        && docId != 'library'
        && docId != 'alerts'
        && docId != 'announcements'
        && docId != 'financial_settings'
        && subCol != 'messaging'
        && subCol != 'library'
        && subCol != 'alerts'
        && subCol != 'announcements';
    }
  }
}
